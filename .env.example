# 运行环境：local、production
ENVIRONMENT=local

# 后端
BACKEND_CORS_ORIGINS=http://localhost:3001
SECRET_KEY=changethis
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=changethis

# PostgreSQL 数据库
POSTGRES_SERVER=localhost
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# LiteLLM 网关
LITELLM_MASTER_KEY=changethis
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=changethis
DEFAULT_MODEL_NAME=deepseek/deepseek-v4-flash

# DeepSeek API
DEEPSEEK_API_KEY=changethis

# MoonShot API
MOONSHOT_API_KEY=changethis

# Firecrawl MCP
FIRECRAWL_API_KEY=changethis

# E2B 沙箱
E2B_API_KEY=changethis
E2B_TEMPLATE=fastapi-react-agent

# 腾讯云 COS
COS_SECRET_ID=changethis
COS_SECRET_KEY=changethis
COS_REGION=changethis
COS_BUCKET=changethis

# Langfuse 平台
LANGFUSE_SECRET_KEY=changethis
LANGFUSE_PUBLIC_KEY=changethis
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Docling 服务
DOCLING_BASE_URL=http://docling:5001

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=changethis
CLOUDFLARE_API_TOKEN=changethis

# 知识库检索
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_chunks_v1

# Embedding 模型，更换时同步更新本组配置和 Collection 名称
# LiteLLM 中的 Embedding 模型名称
EMBEDDING_MODEL=@cf/baai/bge-m3
# 与 Embedding 模型匹配的 Hugging Face tokenizer
EMBEDDING_TOKENIZER=BAAI/bge-m3
# 每个 Embedding 向量的维度
EMBEDDING_DIMENSIONS=1024
# 每个检索切片的最大 token 数
EMBEDDING_CHUNK_MAX_TOKENS=8000
# 单次请求的最大 token 总数
EMBEDDING_BATCH_MAX_TOKENS=50000
# 单次请求的文本条数
EMBEDDING_BATCH_SIZE=100
