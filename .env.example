# 应用
ENVIRONMENT=local
FRONTEND_URL=http://frontend:3000
BACKEND_CORS_ORIGINS=http://localhost:3001

# 登录与管理员
SECRET_KEY=changethis
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=changethis

# 默认对话模型
DEFAULT_MODEL_NAME=deepseek-flash

# NewAPI
NEWAPI_BASE_URL=https://newapi.ai/v1
NEWAPI_API_KEY=changethis

# Docling 文档解析
DOCLING_BASE_URL=http://docling:5001
DOCLING_BIND_HOST=127.0.0.1
DOCLING_PORT=5001
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=3
DOCLING_PICTURE_DESCRIPTION_URL=https://newapi.ai/v1/chat/completions
IMAGE_DESCRIPTION_PROMPT='请用中文简洁、忠实地描述图片，保留理解图片所需的具体细节。若包含图表或数值，请说明对应的标签和数据。'

# Embedding 与文档切片
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIMENSIONS=2048
EMBEDDING_CHUNK_MAX_TOKENS=2048
EMBEDDING_TOKENIZER=/app/models/bge-m3-tokenizer
KNOWLEDGE_MAX_CONCURRENT_DOCUMENTS=3

# 浏览器
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Qdrant 向量数据库
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=knowledge_chunks

# Firecrawl 网页抓取
FIRECRAWL_API_KEY=changethis

# E2B 沙箱
E2B_TEMPLATE=fastapi-react-agent
E2B_API_KEY=changethis

# MCP 接口认证
MCP_INTERNAL_API_KEY=change-internal-mcp-key
MCP_EXTERNAL_API_KEY=change-external-mcp-key

# PostgreSQL 数据库
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Redis 与任务队列
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# 腾讯云 COS 文件存储
COS_REGION=changethis
COS_BUCKET=changethis
COS_SECRET_ID=changethis
COS_SECRET_KEY=changethis

# Langfuse 调用追踪
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=changethis
LANGFUSE_SECRET_KEY=changethis
LANGFUSE_TRACING_ENVIRONMENT=local

# JustOneAPI
JUSTONEAPI_TOKEN=changethis

# Dataify
DATAIFY_API_TOKEN=changethis
