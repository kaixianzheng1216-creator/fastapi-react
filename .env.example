# 运行环境：local、production
ENVIRONMENT=local

# 后端
BACKEND_CORS_ORIGINS=http://localhost:3001
SECRET_KEY=changethis
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=changethis

# PostgreSQL 数据库
POSTGRES_SERVER=localhost
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# LiteLLM 网关
LITELLM_MASTER_KEY=changethis
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=changethis
DEFAULT_MODEL_NAME=deepseek/deepseek-v4-flash

# DeepSeek API
DEEPSEEK_API_KEY=changethis

# MoonShot API
MOONSHOT_API_KEY=changethis

# Firecrawl MCP
FIRECRAWL_API_KEY=changethis

# E2B 沙箱
E2B_API_KEY=changethis
E2B_TEMPLATE=fastapi-react-agent

# 腾讯云 COS
COS_SECRET_ID=changethis
COS_SECRET_KEY=changethis
COS_REGION=changethis
COS_BUCKET=changethis

# Langfuse 平台
LANGFUSE_SECRET_KEY=changethis
LANGFUSE_PUBLIC_KEY=changethis
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Docling 服务
DOCLING_BASE_URL=http://docling:5001

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=changethis
CLOUDFLARE_API_TOKEN=changethis

# 知识库检索
QDRANT_URL=http://localhost:6333
KNOWLEDGE_EMBEDDING_MODEL=knowledge-embedding
KNOWLEDGE_TOKENIZER=BAAI/bge-m3
KNOWLEDGE_EMBEDDING_MAX_INPUT_TOKENS=8000
KNOWLEDGE_EMBEDDING_BATCH_MAX_TOKENS=50000
KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
