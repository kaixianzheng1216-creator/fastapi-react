# 域名
# 部署时应通过环境变量设置生产域名，
# 供 Traefik 转发流量并申请 TLS 证书
DOMAIN=localhost
# 用于测试本地 Traefik 配置
# DOMAIN=localhost.tiangolo.com

# 运行环境：local、staging、production
ENVIRONMENT=local

PROJECT_NAME="FastAPI React Project"
STACK_NAME=fastapi-react-project

# 后端
BACKEND_CORS_ORIGINS=http://localhost:3001
SECRET_KEY=changethis
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=changethis

# PostgreSQL 数据库
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# LiteLLM 网关
LITELLM_MASTER_KEY=sk-changethis
LITELLM_SALT_KEY=changethis
LITELLM_POSTGRES_PASSWORD=changethis
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-changethis
DEFAULT_MODEL_NAME=deepseek/deepseek-v4-flash

# DeepSeek API
DEEPSEEK_API_KEY=changethis

# MoonShot API
MOONSHOT_API_KEY=changethis

# FIRECRAWL MCP
FIRECRAWL_API_KEY=changethis

# E2B 沙箱
E2B_API_KEY=changethis
E2B_TEMPLATE=changethis

# 腾讯云 COS
COS_SECRET_ID=changethis
COS_SECRET_KEY=changethis
COS_REGION=changethis
COS_BUCKET=changethis

# Langfuse 平台
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-changethis
LANGFUSE_SECRET_KEY=sk-lf-changethis

# 请替换为你自己的 Docker 镜像仓库地址
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Docling
DOCLING_BASE_URL=http://docling:5001
